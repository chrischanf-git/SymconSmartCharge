        {
          "type": "CheckBox",
          "name": "HardwareProtectionConfirmed",
          "caption": "Unabhaengiges elektrisches Lastmanagement/Absicherung bestaetigt"
        },
        {
          "type": "CheckBox",
          "name": "PhasesVerified",
          "caption": "Festen Phasenmodus und Fahrzeuglader bestaetigt"
        },
        {
          "type": "CheckBox",
          "name": "LiveControl",
